# Server only. Use a verified Resend sender/domain.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
APP_ORIGIN=http://127.0.0.1:4173

# Verified email addresses allowed to moderate cards (comma-separated).
ADMIN_EMAILS=

# PayPal Sandbox REST app. Client secret and webhook ID stay on the server.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Vercel Preview only. Use an empty, separate database and a database-scoped token.
PREVIEW_TURSO_DATABASE_URL=
PREVIEW_TURSO_AUTH_TOKEN=
